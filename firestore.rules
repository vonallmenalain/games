rules_version = '2';

/*
 * Die Regeln der Mini-Games (Firebase-Projekt games-a0cd4).
 * ---------------------------------------------------------------------------
 * Diese Datei ist die Wahrheit: Was hier durchgeht, geht in der Datenbank
 * durch. Veröffentlicht wird sie von .github/workflows/firestore-rules.yml,
 * sobald sie auf main steht – nicht von Hand in der Console. Zwei Fassungen,
 * eine im Repository und eine in Firebase, laufen sonst auseinander, und
 * welche gilt, sieht man erst, wenn etwas nicht mehr geht.
 *
 * In dieser Datenbank steht genau eine Sache: die Bestenliste – die ewige und
 * die der Turniere, dazu wann ihre Runden gespielt wurden (miniRunden, nur
 * für den Admin). Keine Konten, keine Kinder, kein Fortschritt – wer hier
 * spielt, hat einen Link angeklickt.
 *
 * Angemeldet ist deshalb nur einer: der Admin. Er braucht die Anmeldung für
 * genau eine Sache, die kein Gast dürfen darf – aufräumen.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Wer ist der Admin? ---------------------------------------------------
    // Die Adresse, und sie muss bestätigt sein. Ohne email_verified genügte
    // es, ein Konto mit dieser Adresse anzulegen: Firebase lässt das zu und
    // prüft die Adresse erst, wenn jemand den Link anklickt. Bei Google und
    // beim E-Mail-Link ist sie von sich aus bestätigt, bei Passwort erst nach
    // dem Bestätigungslink.
    //
    // Mehrere Schreibweisen, weil Firebase die Adresse so speichert, wie sie
    // eingetippt wurde.
    function istAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["alain.sc2@gmail.com", "Alain.sc2@gmail.com"];
    }

    // --- Die Bestenliste ------------------------------------------------------
    // Ohne Konto heisst ohne request.auth. Wer hier schreibt, sagt nur, wer er
    // zu sein behauptet – eine Kennung, die sein Gerät sich selbst gegeben hat
    // (mini_…), und ein Name, den er selbst eingetippt hat. Das ist dasselbe
    // Versprechen wie überall hier: eine Bestenliste unter Freunden, keine
    // Urkunde. Deshalb prüfen diese Regeln nicht, WER schreibt, sondern WAS:
    //
    //   ein Dokument je Spiel und Spieler   der Name des Dokuments ist
    //                                       game + "_" + spieler, also kann
    //                                       niemand zwei Einträge in derselben
    //                                       Liste haben
    //   nur diese Felder, in diesen Grenzen ein Name von höchstens 24 Zeichen,
    //                                       eine Punktzahl, ein Zähler
    //   Punkte fallen nie                   ein Eintrag lässt sich nicht
    //                                       kleinrechnen, auch nicht von einem
    //                                       Fremden
    //   Versuche zählen nur hoch            eine Runde, die gespielt wurde,
    //                                       verschwindet nicht wieder
    //   die Spielzeit zählt nur hoch        jede Runde bringt ihre Dauer mit,
    //                                       höchstens eine halbe Stunde
    //                                       (RUNDE_MS); weniger wird es nie
    //
    // Was bleibt, ist, dass jemand einen fremden Eintrag HOCHsetzen könnte.
    // Dagegen hilft nur ein Konto, und ein Konto ist genau das, was dieser
    // Bereich nicht haben soll. Der Admin räumt auf, wenn es je nötig wird –
    // deshalb darf er als Einziger löschen.
    function istMiniSpieler(id) {
      return id is string && id.matches('mini_[A-Za-z0-9_-]{8,48}');
    }

    // Die Spiele, die es gibt. Dieselbe Liste steht in mini-games.js (SPIELE)
    // und in scripts/seiten-bauen.mjs; scripts/pruefen.mjs hält die drei
    // zusammen. Ohne sie stünde in game, was der Schreiber hineinschreibt –
    // und die Sammlung füllte sich mit Spielen, die es nicht gibt.
    function miniSpiele() {
      return [
        "tileMemory",
        "fishPond",
        "leafFlow", "towerStack", "bridgeBuilder", "dartWheel", "vineSwing",
        "tunnelFlight", "driftRace", "planetHop", "moonLander", "gravityRun", "hillGlide",
        "balloonRide", "skiSlalom", "frogHop", "craneHarbor", "ropeWalk",
        "wireLoop", "twinLanes", "keepyUppy",
        "juggler", "highDive", "skyDive", "lumberCut", "batEcho", "timeNinja", "freeDive",
        "numberLine",
        "boilerRoom",
      ];
    }

    // --- Welche Spiele offen sind ---------------------------------------------
    // Ein Dokument, eine Liste: config/miniGames.spiele. Der Adminbereich setzt
    // sie, alle anderen lesen sie – die Startseite zeigt genau diese Spiele,
    // und die Bestenliste fragt genau nach ihnen.
    //
    // Fehlt das Dokument, gelten alle (mini-games.js). Das ist die freundliche
    // Richtung: Eine frische Datenbank zeigt alles, statt nichts.
    //
    // Geschrieben werden darf nur eine Liste aus Spielen, die es gibt. Sonst
    // stünden dort Namen, zu denen keine Seite gehört – und die Startseite
    // zeigte Karten für Spiele, die niemand öffnen kann.
    function istSpieleListe() {
      let d = request.resource.data;
      return d.keys().hasAll(["spiele", "updatedAtMs"])
        && d.keys().hasOnly(["spiele", "tiers", "updatedAtMs", "updatedAt"])
        && d.spiele is list
        && d.spiele.size() <= 50
        && d.spiele.hasOnly(miniSpiele())
        // Die Tiers (admin.js): je Spiel, das es gibt, 1, 2 oder 3. Fehlt das
        // Feld, gilt die Vorgabe aus mini-games.js.
        && (!("tiers" in d) || (d.tiers is map
          && d.tiers.size() <= 50
          && d.tiers.keys().hasOnly(miniSpiele())
          && d.tiers.values().hasOnly([1, 2, 3])))
        && d.updatedAtMs is int;
    }

    match /config/miniGames {
      allow read: if true;
      allow write: if istAdmin() && istSpieleListe();
    }

    function istMiniEintrag(eintragId) {
      let d = request.resource.data;
      return eintragId == d.game + "_" + d.spieler
        && d.keys().hasAll(["game", "spieler", "name", "punkte", "versuche", "updatedAtMs"])
        && d.keys().hasOnly(["game", "spieler", "name", "punkte", "versuche", "erstesMs", "spielMs", "updatedAtMs", "updatedAt"])
        && d.game is string && d.game in miniSpiele()
        && istMiniSpieler(d.spieler)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.punkte is int && d.punkte >= 0 && d.punkte <= 1000000
        && d.versuche is int && d.versuche >= 1 && d.versuche <= 100000
        && (!("spielMs" in d) || (d.spielMs is int && d.spielMs >= 0 && d.spielMs <= 10000000000))
        && d.updatedAtMs is int;
    }

    // Wie lange gespielt wurde, in Millisekunden. Ältere Einträge haben das
    // Feld nicht – dann zählt es als 0. Eine Runde bringt höchstens eine
    // halbe Stunde dazu: Mehr dauert keine, und wer ein Spiel offen liegen
    // lässt, hat nicht gespielt.
    function spielMsNachher() { return request.resource.data.get("spielMs", 0); }
    function spielMsVorher() { return resource.data.get("spielMs", 0); }
    function eineRundeSpielzeit(vorher) {
      return spielMsNachher() >= vorher && spielMsNachher() <= vorher + 1800000;
    }

    // Ein Eintrag bleibt, wem er gehört, und bleibt in seinem Spiel.
    function istDerselbeEintrag() {
      return request.resource.data.game == resource.data.game
        && request.resource.data.spieler == resource.data.spieler;
    }

    match /miniScores/{eintragId} {
      // Lesen darf jeder, auch ohne Konto: Die Liste ist der Sinn der Sache.
      allow read: if true;
      allow create: if istMiniEintrag(eintragId) && request.resource.data.versuche == 1
        && eineRundeSpielzeit(0);
      // Eine Runde: die Punktzahl steigt oder bleibt, der Zähler steigt, die
      // Spielzeit wächst um die Dauer dieser Runde.
      allow update: if istMiniEintrag(eintragId)
        && istDerselbeEintrag()
        && request.resource.data.punkte >= resource.data.punkte
        && request.resource.data.versuche > resource.data.versuche
        && eineRundeSpielzeit(spielMsVorher());
      // Und ein neuer Name, ohne dass eine Runde daraus wird. Wer sich
      // umbenennt, hat nicht gespielt – ein Zähler, der dabei stiege, machte
      // aus jeder Umbenennung einen Versuch, den es nie gab. Erlaubt ist
      // deshalb genau eines: der Name (und die Uhr daneben), sonst nichts.
      allow update: if istMiniEintrag(eintragId)
        && istDerselbeEintrag()
        && request.resource.data.punkte == resource.data.punkte
        && request.resource.data.versuche == resource.data.versuche
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["name", "updatedAtMs", "updatedAt"]);
      // Der Admin führt zusammen, was ein Name auf mehreren Geräten gespielt
      // hat (admin.js, fuehreZusammen): Dort kommt die Spielzeit aller Geräte
      // auf einmal dazu – mehr als eine Runde. Im selben Eintrag, in denselben
      // Grenzen wie jeder andere.
      allow update: if istAdmin() && istMiniEintrag(eintragId) && istDerselbeEintrag();
      allow delete: if istAdmin();
    }

    // --- Die Geister ----------------------------------------------------------
    // Ein Lauf lässt sich aufzeichnen und neben dem nächsten noch einmal
    // abspielen: Wer spielt, spielt dann nicht allein – neben ihm läuft
    // Platz 1 mit, so wie er damals gespielt hat (geist.js). In Blätter im
    // Strom, im Brückenbauer und im Lianenschwung ist das sein Punktestand
    // Viertelsekunde für Viertelsekunde, in den beiden letzten dazu sein Weg.
    //
    // Warum das eine eigene Sammlung ist und nicht ein Feld in miniScores:
    // Die Startseite liest JEDES Punkte-Dokument, um die Hall of Fame zu
    // bauen. Läge die Aufzeichnung dort, lüde jeder Besuch der Startseite ein
    // paar Kilobyte je Spieler mit, die dort niemand ansieht. Hier wird nur
    // gelesen, was die Spielseite wirklich braucht: drei Dokumente.
    //
    // Geprüft wird wie nebenan das WAS, nicht das WER:
    //
    //   ein Dokument je Spiel und Spieler   derselbe Dokumentname wie in
    //                                       miniScores
    //   bahn ist Text und hat eine Grenze   eine Aufzeichnung ist gross; ohne
    //                                       Grenze wäre sie beliebig gross
    //   level sagt, wozu sie gehört         ein Geist aus v1 ist auf v2
    //                                       sinnlos, und das Spiel zeigt nur
    //                                       die, die passen
    //   Punkte fallen nie                   sonst überschriebe ein schwacher
    //                                       Lauf den guten, den er ersetzt
    function istGeist(eintragId) {
      let d = request.resource.data;
      return eintragId == d.game + "_" + d.spieler
        && d.keys().hasAll(["game", "spieler", "name", "punkte", "level", "bahn", "updatedAtMs"])
        && d.keys().hasOnly(["game", "spieler", "name", "punkte", "level", "bahn", "updatedAtMs", "updatedAt"])
        && d.game is string && d.game in miniSpiele()
        && istMiniSpieler(d.spieler)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.punkte is int && d.punkte >= 0 && d.punkte <= 1000000
        && d.level is string && d.level.size() > 0 && d.level.size() <= 16
        && d.bahn is string && d.bahn.size() > 0 && d.bahn.size() <= 12000
        && d.updatedAtMs is int;
    }

    match /miniGeister/{eintragId} {
      allow read: if true;
      allow create: if istGeist(eintragId);
      // Ein besserer Lauf ersetzt den alten. Ein schlechterer nicht – sonst
      // liefe neben dem Spieler irgendwann ein Geist, der langsamer war als
      // die Zahl, die in der Bestenliste daneben steht.
      allow update: if istGeist(eintragId)
        && istDerselbeEintrag()
        && request.resource.data.punkte >= resource.data.punkte;
      allow delete: if istAdmin();
    }

    // --- Umzüge --------------------------------------------------------------
    // Führt der Admin zwei Namen zusammen (admin.js, fuehreNamenZusammen)
    // oder einen Namen von mehreren Geräten (fuehreZusammen), bleibt je Spiel
    // ein Eintrag unter EINER Kennung; die Einträge der anderen werden
    // gelöscht. Ein Gerät, das noch unter einer davon spielt, fände danach
    // nichts mehr von sich und finge unter dem alten Namen neu an. Deshalb
    // bleibt je verschwundener Kennung ein Zettel, wohin es weitergeht:
    //
    //   miniUmzuege/<kennung>   nach (die Kennung, die bleibt), name
    //
    // Das Gerät fragt beim Öffnen nach seiner eigenen Kennung (mini-games.js,
    // folgeUmzug) – nach einem Dokument, nie nach einer Liste. Schreiben darf
    // nur der Admin: Ein Zettel lenkt die Runden eines fremden Geräts um, und
    // das soll kein Gast können.
    function istUmzug(kennung) {
      let d = request.resource.data;
      return istMiniSpieler(kennung)
        && d.keys().hasAll(["nach", "name", "updatedAtMs"])
        && d.keys().hasOnly(["nach", "name", "updatedAtMs", "updatedAt"])
        && istMiniSpieler(d.nach)
        && d.nach != kennung
        && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.updatedAtMs is int;
    }

    match /miniUmzuege/{kennung} {
      allow get: if true;
      allow list: if istAdmin();
      allow create, update: if istAdmin() && istUmzug(kennung);
      allow delete: if istAdmin();
    }

    // --- Das Rundenprotokoll -------------------------------------------------
    // miniScores hält je Spiel und Spieler nur Summen – den Bestwert, wie oft,
    // wie lange. Wann gespielt wurde, steht dort nicht, und ohne das lässt
    // sich im Adminbereich nicht fragen, was gestern Abend gespielt wurde.
    // Deshalb hält jede Runde, die in miniScores zählt, zusätzlich ein eigenes
    // Dokument fest (cloud.js, speichere – in derselben Transaktion):
    //
    //   miniRunden/<spiel>_<spieler>_<nr>
    //
    // nr ist die wievielte Runde dieses Eintrags: der Zähler versuche, wie er
    // nach ihr in miniScores steht.
    //
    // Lesen darf nur der Admin. Wer wann gespielt hat, braucht keine Seite
    // ausser dem Adminbereich, und es geht auch niemanden sonst etwas an.
    //
    // Geprüft wird wie nebenan das WAS:
    //
    //   nur diese Felder, in diesen Grenzen  wie in miniScores; eine Runde
    //                                        dauert höchstens 30 Minuten
    //   der Name passt zu den Feldern        <spiel>_<spieler>_<nr>
    //   die Uhr stimmt ungefähr              zeitMs höchstens zehn Minuten
    //                                        neben der des Servers – oder,
    //                                        ohne Netz gespielt (offline),
    //                                        bis zu 30 Tage davor
    //   die Runde zählt in miniScores        im selben Schreiben steigt dort
    //                                        versuche von nr − 1 auf nr, die
    //                                        Spielzeit um genau ms, der Name
    //                                        ist derselbe und der Bestwert
    //                                        mindestens so hoch (get vorher,
    //                                        getAfter nachher). Eine Runde,
    //                                        die nirgends zählt, gibt es so
    //                                        nicht – und zu jeder Runde nur
    //                                        ein Dokument: Sein Name ist mit
    //                                        nr vergeben.
    //   nie geändert                         was gespielt wurde, bleibt
    //
    // Löschen darf nur der Admin, mit dem Eintrag, zu dem sie gehören
    // (admin.js, loesche). Und nur er legt eine Runde an, ohne dass in
    // miniScores eine dazukommt: beim Zusammenführen, wo die Runden der
    // anderen Geräte unter die Kennung ziehen, unter der der Eintrag bleibt
    // (cloud.js, zieheRundenUm).
    function istRunde(rundeId) {
      let d = request.resource.data;
      return d.keys().hasAll(["game", "spieler", "name", "nr", "punkte", "ms", "zeitMs"])
        && d.keys().hasOnly(["game", "spieler", "name", "nr", "punkte", "ms", "zeitMs", "quelle", "offline"])
        && d.game is string && d.game in miniSpiele()
        && istMiniSpieler(d.spieler)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.nr is int && d.nr >= 1 && d.nr <= 100000
        && d.punkte is int && d.punkte >= 0 && d.punkte <= 1000000
        && d.ms is int && d.ms >= 0 && d.ms <= 1800000
        && d.zeitMs is int
        // Woher sie kommt: aus einem Turnier oder einem Multiplayer. Fehlt
        // das Feld, wurde auf der Spielseite selbst gespielt.
        && (!("quelle" in d) || d.quelle in ["turnier", "live"])
        // Ohne Netz gespielt und später hochgeladen (mini-games.js,
        // sendeWartende). Fehlt das Feld, kam die Runde gleich.
        && (!("offline" in d) || d.offline == true)
        && rundeId == d.game + "_" + d.spieler + "_" + string(d.nr);
    }

    function zurUhrDesServers(ms) {
      return ms >= request.time.toMillis() - 600000
        && ms <= request.time.toMillis() + 600000;
    }

    // Ohne Netz gespielt: Die Runde kommt, sobald das Gerät wieder online
    // ist, mit der Uhrzeit, zu der sie zu Ende war – höchstens 30 Tage
    // zurück, nie in der Zukunft.
    function ohneNetzGespielt(d) {
      return d.get("offline", false) == true
        && d.zeitMs >= request.time.toMillis() - 2592000000
        && d.zeitMs <= request.time.toMillis() + 600000;
    }

    function eintragDerRunde(d) {
      return /databases/$(database)/documents/miniScores/$(d.game + "_" + d.spieler);
    }

    function zaehltInMiniScores(d) {
      let nachher = getAfter(eintragDerRunde(d)).data;
      return nachher.versuche == d.nr
        && nachher.name == d.name
        && nachher.punkte >= d.punkte
        && ((d.nr == 1
              && !exists(eintragDerRunde(d))
              && nachher.get("spielMs", 0) == d.ms)
          || (d.nr > 1
              && get(eintragDerRunde(d)).data.versuche == d.nr - 1
              && nachher.get("spielMs", 0) == get(eintragDerRunde(d)).data.get("spielMs", 0) + d.ms));
    }

    match /miniRunden/{rundeId} {
      allow read: if istAdmin();
      allow create: if istRunde(rundeId)
        && (zurUhrDesServers(request.resource.data.zeitMs) || ohneNetzGespielt(request.resource.data))
        && zaehltInMiniScores(request.resource.data);
      allow create: if istAdmin() && istRunde(rundeId);
      allow delete: if istAdmin();
    }

    // --- Turniere ------------------------------------------------------------
    // Ein Turnier ist eine eigene, kleine Bestenliste mit Regeln: wann es
    // läuft, welche Spiele dazugehören, wie viele Versuche jeder hat. Anlegen,
    // ändern, anhalten und löschen darf nur der Admin.
    //
    // Gelesen wird es auf zwei Wegen, und die sind mit Absicht verschieden:
    //
    //   get    ein einzelnes Turnier, über seinen Namen. Das darf jeder – wer
    //          den Link hat, soll mitspielen können, ohne Konto.
    //   list   mehrere auf einmal. Das darf nur, wer ausschliesslich nach
    //          öffentlichen fragt (sichtbar == "alle"). Ein Turnier "nur mit
    //          Link" steht so in keiner Liste; seinen Namen kennt nur, wem der
    //          Link geschickt wurde. Der Name ist deshalb lang und zufällig
    //          (admin.js), nicht "herbst24".
    //
    // Firestore prüft bei einer Abfrage nicht Dokument für Dokument, sondern
    // die Abfrage selbst: Ohne where("sichtbar", "==", "alle") wird sie als
    // Ganzes abgewiesen, auch wenn zufällig nur öffentliche Turniere darin
    // stünden. Genau so ist es gemeint.
    function istTurnier(turnierId) {
      let d = request.resource.data;
      return turnierId.matches('[a-z0-9-]{6,48}')
        && d.keys().hasAll(["name", "spiele", "startMs", "endeMs", "versuche", "zaehlt", "wertung",
                            "aufgaben", "sichtbar", "verdeckt", "aktiv", "erstelltMs", "updatedAtMs"])
        && d.keys().hasOnly(["name", "beschreibung", "spiele", "startMs", "endeMs", "versuche", "zaehlt",
                             "wertung", "aufgaben", "sichtbar", "verdeckt", "aktiv", "spitzeWartet",
                             "ohneGeist", "ohneReplay", "nurLive", "erstelltMs", "updatedAtMs", "updatedAt"])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (!("beschreibung" in d) || (d.beschreibung is string && d.beschreibung.size() <= 600))
        && d.spiele is list && d.spiele.size() > 0 && d.spiele.size() <= 50
        && d.spiele.hasOnly(miniSpiele())
        && d.startMs is int && d.endeMs is int && d.endeMs > d.startMs
        && d.versuche is int && d.versuche >= 0 && d.versuche <= 100
        && d.zaehlt in ["bester", "summe"]
        // Alle Versuche zusammenzählen geht nur, wenn es eine Zahl davon gibt –
        // sonst gewänne, wer am längsten spielt.
        && !(d.zaehlt == "summe" && d.versuche == 0)
        // "Nur wer nicht vorne liegt": Wer in einem Spiel allein auf Platz 1
        // steht, wartet dort, bis ihn jemand einholt. Das ist eine eigene Art,
        // Versuche zu verteilen – neben "unbegrenzt" und einer festen Zahl,
        // nicht zusätzlich zu ihr. Fehlt das Feld (jedes Turnier von vorher),
        // gilt es als aus.
        //
        // Durchgesetzt wird das von der Seite (turnier.js), nicht von hier:
        // Wer vorne liegt, lässt sich nur aus allen Einträgen eines Spiels
        // ablesen, und eine Regel kann keine Liste befragen. Wie "verdeckt"
        // ist es für das Spiel unter Freunden, nicht gegen jemanden, der die
        // Datenbank von Hand beschreibt.
        && d.get("spitzeWartet", false) is bool
        && !(d.get("spitzeWartet", false) == true && d.versuche != 0)
        && d.wertung in ["platz", "prozent"]
        // "wieErster": jeder Versuch ist derselbe Lauf, für alle – der, auf
        // dem auch Platz 1 vorne liegt (turnier.js, stelleZufall).
        && d.aufgaben in ["gleich", "zufall", "wieErster"]
        && d.sichtbar in ["alle", "link"]
        && d.verdeckt is bool
        // Ohne Gegner beim Spielen (geist.js): weder Platz 1 noch die eigene
        // Bestmarke laufen mit. Fehlt das Feld, werden sie gezeigt.
        && d.get("ohneGeist", false) is bool
        // Ohne Replays: Die besten Läufe dieses Turniers lassen sich nicht
        // anschauen (turnier.js, geist.js). Fehlt das Feld, lassen sie sich.
        && d.get("ohneReplay", false) is bool
        // Nur live (live.js): Gespielt wird nur an Live-Abenden, die zum
        // Turnier gehören – keine Versuche dazwischen (darfBeginnen). Fehlt
        // das Feld, ist es ein Turnier wie jedes von vorher.
        && d.get("nurLive", false) is bool
        && d.aktiv is bool
        && d.erstelltMs is int
        && d.updatedAtMs is int;
    }

    // Ein Eintrag in der Liste eines Turniers: ein Dokument je Spiel und
    // Spieler, wie in miniScores – mit einem Unterschied, und um den geht es
    // hier. Ein Versuch zählt, sobald er BEGINNT, nicht erst, wenn er endet.
    // Sonst hätte ein Turnier mit drei Versuchen beliebig viele: Wer eine
    // schlechte Runde kommen sieht, lädt neu, und die Runde hat es nie gegeben.
    //
    // Deshalb zwei Schritte je Versuch:
    //
    //   Beginn   versuche + 1, offen = true, die Punkte bleiben stehen
    //   Ende     offen: true → false, die Punkte steigen oder bleiben
    //
    // Und nur ein Ende je Beginn: Ohne "offen" liesse ein Versuch beliebig
    // viele Ergebnisse nachreichen, und "bester Versuch" hiesse "bester von
    // allen, die man je eingetippt hat".
    //
    // Wie in miniScores wird nicht geprüft, WER schreibt – ohne Konto geht das
    // nicht –, sondern WAS, und hier auch WANN: Das Turnier selbst wird dafür
    // nachgelesen (get). Läuft es? Ist es angehalten? Gehört das Spiel dazu?
    // Ist noch ein Versuch übrig?
    function istTurnierEintrag(eintragId) {
      let d = request.resource.data;
      return eintragId == d.game + "_" + d.spieler
        && d.keys().hasAll(["game", "spieler", "name", "punkte", "versuche", "offen", "updatedAtMs"])
        && d.keys().hasOnly(["game", "spieler", "name", "punkte", "versuche", "offen", "erstesMs",
                             "updatedAtMs", "updatedAt"])
        && d.game is string && d.game in miniSpiele()
        && istMiniSpieler(d.spieler)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.punkte is int && d.punkte >= 0 && d.punkte <= 10000000
        && d.versuche is int && d.versuche >= 1 && d.versuche <= 100000
        && d.offen is bool
        && d.updatedAtMs is int;
    }

    function turnierDaten(turnierId) {
      return get(/databases/$(database)/documents/miniTurniere/$(turnierId)).data;
    }

    // Gehört das Spiel dazu, und liegt jetzt in der Zeit des Turniers?
    // "nachspiel" ist die Zeit, die ein Ergebnis nach dem Ende noch
    // eingetragen werden darf: Wer eine Minute vor Schluss beginnt, soll seine
    // Runde zu Ende spielen dürfen.
    function imZeitraum(turnierId, nachspiel) {
      let t = turnierDaten(turnierId);
      let jetzt = request.time.toMillis();
      return request.resource.data.game in t.spiele
        && jetzt >= t.startMs
        && jetzt <= t.endeMs + nachspiel;
    }

    // Beginnen darf ein Versuch nur, solange das Turnier läuft – nicht vor dem
    // Start, nicht nach dem Ende, nicht, solange es angehalten ist. Zu Ende
    // gehen darf einer, der vorher begonnen hat, auch danach: Das Anhalten
    // hält neue Versuche auf, es nimmt keinem die Runde weg, die er gerade
    // spielt.
    function darfBeginnen(turnierId) {
      return turnierDaten(turnierId).aktiv == true
        && turnierDaten(turnierId).get("nurLive", false) == false
        && imZeitraum(turnierId, 0);
    }

    // Der Endstand eines Live-Abends, der zu einem Turnier gehört (live.js,
    // «Abend abschliessen»). Er zählt in der Gesamtwertung wie ein Spiel,
    // mal sein Gewicht (turnier.js, gesamtwertung). Schreiben darf ihn nur
    // der Admin – er hat den Abend geleitet. Der Name ist der Code des Abends
    // und wann er begann: Codes kommen irgendwann wieder.
    function istLiveErgebnis(abendId) {
      let d = request.resource.data;
      return abendId.matches('[A-Z2-9]{4}-[0-9]{6,16}')
        && d.keys().hasAll(["name", "gewicht", "endstand", "erstelltMs", "updatedAtMs"])
        && d.keys().hasOnly(["name", "gewicht", "endstand", "runden", "spiele", "erstelltMs", "updatedAtMs", "updatedAt"])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.gewicht is int && d.gewicht >= 0 && d.gewicht <= 3
        && d.endstand is list && d.endstand.size() <= 200
        && (!("runden" in d) || (d.runden is int && d.runden >= 0 && d.runden <= 100))
        && (!("spiele" in d) || (d.spiele is list && d.spiele.size() <= 50))
        && d.erstelltMs is int
        && d.updatedAtMs is int;
    }

    function versuchUebrig(turnierId) {
      let t = turnierDaten(turnierId);
      return t.versuche == 0 || request.resource.data.versuche <= t.versuche;
    }

    match /miniTurniere/{turnierId} {
      allow get: if true;
      allow list: if istAdmin() || resource.data.sichtbar == "alle";
      allow create, update: if istAdmin() && istTurnier(turnierId);
      allow delete: if istAdmin();

      match /eintraege/{eintragId} {
        // Wer das Turnier kennt, sieht seine Liste – wie bei der ewigen.
        allow read: if true;
        // Der erste Versuch beginnt.
        allow create: if istTurnierEintrag(eintragId)
          && darfBeginnen(turnierId)
          && versuchUebrig(turnierId)
          && request.resource.data.versuche == 1
          && request.resource.data.offen == true
          && request.resource.data.punkte == 0;
        // Ein weiterer Versuch beginnt. War der vorige noch offen, bleibt sein
        // Ergebnis eben aus – er zählt trotzdem.
        allow update: if istTurnierEintrag(eintragId)
          && istDerselbeEintrag()
          && darfBeginnen(turnierId)
          && versuchUebrig(turnierId)
          && request.resource.data.versuche == resource.data.versuche + 1
          && request.resource.data.offen == true
          && request.resource.data.punkte == resource.data.punkte;
        // Der Versuch ist zu Ende: sein Ergebnis, genau einmal – auch wenn das
        // Turnier inzwischen angehalten wurde. Zehn Minuten Nachspiel nach dem
        // Schluss; keine Runde hier dauert länger.
        allow update: if istTurnierEintrag(eintragId)
          && istDerselbeEintrag()
          && imZeitraum(turnierId, 600000)
          && resource.data.offen == true
          && request.resource.data.offen == false
          && request.resource.data.versuche == resource.data.versuche
          && request.resource.data.punkte >= resource.data.punkte;
        // Ein neuer Name, sonst nichts – auch nach dem Ende.
        allow update: if istTurnierEintrag(eintragId)
          && istDerselbeEintrag()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["name", "updatedAtMs", "updatedAt"]);
        allow delete: if istAdmin();
      }

      // Der beste Lauf eines Spielers in diesem Turnier – für den, der gegen
      // ihn spielt (geist.js). Dieselben Felder wie miniGeister, und
      // dieselbe Regel: Ein schwächerer Lauf ersetzt keinen besseren. Dazu
      // die des Turniers: Das Spiel gehört dazu, das Turnier läuft (oder ist
      // eben erst vorbei, wie bei einem Ergebnis), und wer einen Lauf
      // hinterlegt, hat hier wirklich einen Versuch begonnen.
      match /live/{abendId} {
        allow read: if true;
        allow create, update: if istAdmin() && istLiveErgebnis(abendId);
        allow delete: if istAdmin();
      }

      match /geister/{eintragId} {
        allow read: if true;
        allow create: if istGeist(eintragId)
          && imZeitraum(turnierId, 600000)
          && exists(/databases/$(database)/documents/miniTurniere/$(turnierId)/eintraege/$(eintragId));
        allow update: if istGeist(eintragId)
          && istDerselbeEintrag()
          && imZeitraum(turnierId, 600000)
          && request.resource.data.punkte >= resource.data.punkte;
        allow delete: if istAdmin();
      }
    }

    // --- Alles andere ---------------------------------------------------------
    // Es gibt nichts anderes. Diese Zeile steht trotzdem hier, damit eine
    // Sammlung, die jemand morgen anlegt, nicht offen dasteht, weil niemand an
    // eine Regel dafür gedacht hat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
