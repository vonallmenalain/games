{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "$code": {
        ".read": "$code.matches(/^[A-Z2-9]{4,12}$/)",
        ".write": "$code.matches(/^[A-Z2-9]{4,12}$/) && auth != null && auth.token.email_verified == true && (auth.token.email == 'alain.sc2@gmail.com' || auth.token.email == 'Alain.sc2@gmail.com')",
        "info": {
          ".validate": "newData.hasChildren(['name', 'host', 'erstellt', 'programm', 'einstellungen'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "host": { ".validate": "newData.isString() && newData.val() == auth.uid" },
          "hostKennung": { ".validate": "newData.isString() && newData.val().matches(/^mini_[A-Za-z0-9_-]+$/)" },
          "turnier": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{6,48}$/)" },
          "turnierName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "erstellt": { ".validate": "newData.isNumber()" },
          "programm": { ".validate": "newData.hasChildren()" },
          "einstellungen": { ".validate": "newData.hasChildren()" },
          "$anderes": { ".validate": false }
        },
        "zustand": {
          ".validate": "newData.hasChildren(['phase'])",
          "phase": { ".validate": "newData.isString() && newData.val().matches(/^(lobby|runde|pause|ende)$/)" }
        },
        "spieler": {
          "$kennung": {
            ".write": "$kennung.matches(/^mini_[A-Za-z0-9_-]+$/) && $kennung.length <= 53 && root.child('live').child($code).child('info').exists()",
            ".validate": "newData.hasChildren(['name', 'online'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
            "online": { ".validate": "newData.isBoolean()" },
            "seit": { ".validate": "newData.isNumber()" },
            "$anderes": { ".validate": false }
          }
        },
        "punkte": {
          "$nr": {
            "$kennung": {
              ".write": "$nr.matches(/^[0-9]+$/) && $nr.length <= 3 && $kennung.matches(/^mini_[A-Za-z0-9_-]+$/) && $kennung.length <= 53 && root.child('live').child($code).child('info').exists()",
              ".validate": "newData.hasChildren(['p', 'fertig'])",
              "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
              "fertig": { ".validate": "newData.isBoolean()" },
              "t": { ".validate": "newData.isNumber()" },
              "$anderes": { ".validate": false }
            }
          }
        },
        "lage": {
          "$kennung": {
            ".write": "$kennung.matches(/^mini_[A-Za-z0-9_-]+$/) && $kennung.length <= 53 && root.child('live').child($code).child('info').exists()",
            ".validate": "newData.hasChildren(['n', 't', 'a', 'b'])",
            "n": { ".validate": "newData.isNumber()" },
            "t": { ".validate": "newData.isNumber()" },
            "a": { ".validate": "newData.isNumber()" },
            "b": { ".validate": "newData.isNumber()" },
            "c": { ".validate": "newData.isNumber()" },
            "p": { ".validate": "newData.isNumber()" },
            "$anderes": { ".validate": false }
          }
        },
        "$anderes": { ".validate": false }
      }
    },
    "liveOffen": {
      ".read": true,
      "$code": {
        ".write": "$code.matches(/^[A-Z2-9]{4,12}$/) && auth != null && auth.token.email_verified == true && (auth.token.email == 'alain.sc2@gmail.com' || auth.token.email == 'Alain.sc2@gmail.com')",
        ".validate": "newData.hasChildren(['name']) && root.child('live').child($code).child('info').exists()",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "seit": { ".validate": "newData.isNumber()" },
        "$anderes": { ".validate": false }
      }
    },
    "turnierLive": {
      "$turnier": {
        ".read": "$turnier.matches(/^[a-z0-9-]+$/)",
        ".write": "$turnier.matches(/^[a-z0-9-]+$/) && auth != null && auth.token.email_verified == true && (auth.token.email == 'alain.sc2@gmail.com' || auth.token.email == 'Alain.sc2@gmail.com')",
        ".validate": "newData.hasChildren(['code', 'name'])",
        "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z2-9]{4,12}$/)" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "seit": { ".validate": "newData.isNumber()" },
        "$anderes": { ".validate": false }
      }
    },
    "turnierMitschauen": {
      "$turnier": {
        ".read": "$turnier.matches(/^[a-z0-9-]{6,48}$/)",
        "$kennung": {
          ".write": "$turnier.matches(/^[a-z0-9-]{6,48}$/) && $kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
          ".validate": "newData.hasChildren(['name', 'runde', 'lebt'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "lebt": { ".validate": "newData.isNumber()" },
          "runde": {
            ".validate": "newData.hasChildren(['id', 'spiel', 'start'])",
            "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{4,24}$/)" },
            "spiel": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,30}$/)" },
            "saat": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "start": { ".validate": "newData.isNumber()" },
            "$anderes": { ".validate": false }
          },
          "teile": {
            "$n": { ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.isString() && newData.val().length <= 8000" }
          },
          "ende": {
            ".validate": "newData.hasChildren(['p'])",
            "p": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "o": { ".validate": "newData.isNumber()" },
            "z": { ".validate": "newData.isNumber()" },
            "$anderes": { ".validate": false }
          },
          "$anderes": { ".validate": false }
        }
      }
    },
    "mitschauen": {
      "$kennung": {
        ".read": "$kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
        ".write": "$kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
        ".validate": "newData.hasChildren(['name', 'runde', 'lebt'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
        "lebt": { ".validate": "newData.isNumber()" },
        "runde": {
          ".validate": "newData.hasChildren(['id', 'spiel', 'start'])",
          "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{4,24}$/)" },
          "spiel": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,30}$/)" },
          "saat": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "start": { ".validate": "newData.isNumber()" },
          "$anderes": { ".validate": false }
        },
        "teile": {
          "$n": { ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.isString() && newData.val().length <= 8000" }
        },
        "ende": {
          ".validate": "newData.hasChildren(['p'])",
          "p": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "o": { ".validate": "newData.isNumber()" },
          "z": { ".validate": "newData.isNumber()" },
          "$anderes": { ".validate": false }
        },
        "$anderes": { ".validate": false }
      }
    },
    "amSpielen": {
      ".read": true,
      "$kennung": {
        ".write": "$kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
        ".validate": "newData.hasChildren(['name', 'spiel', 'lebt'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
        "spiel": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,30}$/)" },
        "lebt": { ".validate": "newData.isNumber()" },
        "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
        "fertig": { ".validate": "newData.isBoolean()" },
        "$anderes": { ".validate": false }
      }
    },
    "turnierAmSpielen": {
      "$turnier": {
        ".read": "$turnier.matches(/^[a-z0-9-]{6,48}$/)",
        "$kennung": {
          ".write": "$turnier.matches(/^[a-z0-9-]{6,48}$/) && $kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
          ".validate": "newData.hasChildren(['name', 'spiel', 'lebt'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "spiel": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,30}$/)" },
          "lebt": { ".validate": "newData.isNumber()" },
          "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "fertig": { ".validate": "newData.isBoolean()" },
          "$anderes": { ".validate": false }
        }
      }
    }
  }
}
