{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "$code": {
        ".read": "$code.matches(/^[A-Z2-9]{4,12}$/)",
        ".write": "$code.matches(/^[A-Z2-9]{4,12}$/) && auth != null && auth.token.email_verified == true && (auth.token.email == 'alain.sc2@gmail.com' || auth.token.email == 'Alain.sc2@gmail.com')",
        "info": {
          ".validate": "newData.hasChildren(['name', 'host', 'erstellt', 'programm', 'einstellungen'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "host": { ".validate": "newData.isString() && newData.val() == auth.uid" },
          "hostKennung": { ".validate": "newData.isString() && newData.val().matches(/^mini_[A-Za-z0-9_-]+$/)" },
          "turnier": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{6,48}$/)" },
          "turnierName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "erstellt": { ".validate": "newData.isNumber()" },
          "programm": { ".validate": "newData.hasChildren()" },
          "einstellungen": { ".validate": "newData.hasChildren()" },
          "$anderes": { ".validate": false }
        },
        "zustand": {
          ".validate": "newData.hasChildren(['phase'])",
          "phase": { ".validate": "newData.isString() && newData.val().matches(/^(lobby|runde|pause|ende)$/)" }
        },
        "spieler": {
          "$kennung": {
            ".write": "$kennung.matches(/^mini_[A-Za-z0-9_-]+$/) && $kennung.length <= 53 && root.child('live').child($code).child('info').exists()",
            ".validate": "newData.hasChildren(['name', 'online'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
            "online": { ".validate": "newData.isBoolean()" },
            "seit": { ".validate": "newData.isNumber()" },
            "$anderes": { ".validate": false }
          }
        },
        "punkte": {
          "$nr": {
            "$kennung": {
              ".write": "$nr.matches(/^[0-9]+$/) && $nr.length <= 3 && $kennung.matches(/^mini_[A-Za-z0-9_-]+$/) && $kennung.length <= 53 && root.child('live').child($code).child('info').exists()",
              ".validate": "newData.hasChildren(['p', 'fertig'])",
              "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
              "fertig": { ".validate": "newData.isBoolean()" },
              "t": { ".validate": "newData.isNumber()" },
              "$anderes": { ".validate": false }
            }
          }
        },
        "lage": {
          "$kennung": {
            ".write": "$kennung.matches(/^mini_[A-Za-z0-9_-]+$/) && $kennung.length <= 53 && root.child('live').child($code).child('info').exists()",
            ".validate": "newData.hasChildren(['n', 't', 'a', 'b'])",
            "n": { ".validate": "newData.isNumber()" },
            "t": { ".validate": "newData.isNumber()" },
            "a": { ".validate": "newData.isNumber()" },
            "b": { ".validate": "newData.isNumber()" },
            "c": { ".validate": "newData.isNumber()" },
            "p": { ".validate": "newData.isNumber()" },
            "v": { ".validate": "newData.isString() && newData.val().length <= 240 && newData.val().matches(/^[-0-9,;]*$/)" },
            "$anderes": { ".validate": false }
          }
        },
        "$anderes": { ".validate": false }
      }
    },
    "partie": {
      "$raum": {
        ".read": "$raum.matches(/^[A-Z2-9]{10}$/)",
        "info": {
          ".write": "$raum.matches(/^[A-Z2-9]{10}$/) && !data.exists()",
          ".validate": "newData.hasChildren(['spiel', 'erstellt'])",
          "spiel": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{3,20}$/)" },
          "erstellt": { ".validate": "newData.isNumber()" },
          "$anderes": { ".validate": false }
        },
        "code": {
          ".write": "$raum.matches(/^[A-Z2-9]{10}$/) && !data.exists() && (root.child('partie').child($raum).child('a').exists() || newData.parent().child('a').exists())",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
        },
        "a": {
          ".write": "$raum.matches(/^[A-Z2-9]{10}$/) && newData.exists() && (!data.exists() || data.child('kennung').val() == newData.child('kennung').val())",
          ".validate": "newData.hasChildren(['kennung', 'name', 'online'])",
          "kennung": { ".validate": "newData.isString() && newData.val().matches(/^mini_[A-Za-z0-9_-]{8,48}$/)" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "online": { ".validate": "newData.isBoolean()" },
          "seit": { ".validate": "newData.isNumber()" },
          "$anderes": { ".validate": false }
        },
        "b": {
          ".write": "$raum.matches(/^[A-Z2-9]{10}$/) && newData.exists() && root.child('partie').child($raum).child('a').exists() && (!data.exists() || data.child('kennung').val() == newData.child('kennung').val())",
          ".validate": "newData.hasChildren(['kennung', 'name', 'online']) && newData.child('kennung').val() != root.child('partie').child($raum).child('a').child('kennung').val()",
          "kennung": { ".validate": "newData.isString() && newData.val().matches(/^mini_[A-Za-z0-9_-]{8,48}$/)" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "online": { ".validate": "newData.isBoolean()" },
          "seit": { ".validate": "newData.isNumber()" },
          "$anderes": { ".validate": false }
        },
        "stand": {
          ".write": "$raum.matches(/^[A-Z2-9]{10}$/) && newData.exists() && (root.child('partie').child($raum).child('a').exists() || newData.parent().child('a').exists())",
          ".validate": "newData.hasChildren(['zuege', 'beginnt', 'serie', 'nr', 'saat']) && ((!data.exists() && newData.child('zuege').val() == '' && newData.child('serie').val() == '' && newData.child('nr').val() == 0 && newData.child('beginnt').val() == 'a') || (data.exists() && newData.child('nr').val() == data.child('nr').val() && newData.child('beginnt').val() == data.child('beginnt').val() && newData.child('serie').val() == data.child('serie').val() && newData.child('saat').val() == data.child('saat').val() && newData.child('zuege').val().length > data.child('zuege').val().length && newData.child('zuege').val().beginsWith(data.child('zuege').val())) || (data.exists() && newData.child('nr').val() == data.child('nr').val() + 1 && newData.child('zuege').val() == '' && newData.child('serie').val().length == data.child('serie').val().length + 1 && newData.child('serie').val().beginsWith(data.child('serie').val())))",
          "zuege": { ".validate": "newData.isString() && newData.val().length <= 20000 && newData.val().matches(/^[A-Za-z0-9.,:;_-]*$/)" },
          "beginnt": { ".validate": "newData.isString() && newData.val().matches(/^[ab]$/)" },
          "serie": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{0,1000}$/)" },
          "nr": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "saat": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295" },
          "$anderes": { ".validate": false }
        },
        "live": {
          "$stueck": {
            ".write": "$raum.matches(/^[A-Z2-9]{10}$/) && $stueck.matches(/^[0-9]{1,4}-[0-9]{1,2}$/) && root.child('partie').child($raum).child('b').exists()",
            ".validate": "newData.isString() && newData.val().length <= 40000 && newData.val().matches(/^[0-9,;|]*$/)"
          }
        },
        "$anderes": { ".validate": false }
      }
    },
    "partieCode": {
      "$code": {
        ".read": "$code.matches(/^[0-9]{4}$/)",
        ".write": "$code.matches(/^[0-9]{4}$/) && ((newData.exists() && (!data.exists() || data.child('bis').val() < now)) || (!newData.exists() && data.exists() && (data.child('bis').val() < now || root.child('partie').child(data.child('raum').val()).child('b').exists())))",
        ".validate": "newData.hasChildren(['raum', 'spiel', 'bis'])",
        "raum": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z2-9]{10}$/) && root.child('partie').child(newData.val()).child('a').exists()" },
        "spiel": { ".validate": "newData.isString() && newData.val() == root.child('partie').child(newData.parent().child('raum').val()).child('info').child('spiel').val()" },
        "bis": { ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 10800000" },
        "$anderes": { ".validate": false }
      }
    },
    "partieOffen": {
      "$turnier": {
        ".read": "$turnier.matches(/^[a-z0-9-]{6,48}$/)",
        "$raum": {
          ".write": "$turnier.matches(/^[a-z0-9-]{6,48}$/) && $raum.matches(/^[A-Z2-9]{10}$/) && (!newData.exists() || (root.child('partie').child($raum).child('a').exists() && !root.child('partie').child($raum).child('b').exists()))",
          ".validate": "newData.hasChildren(['name', 'kennung', 'spiel', 'seit']) && newData.child('kennung').val() == root.child('partie').child($raum).child('a').child('kennung').val()",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "kennung": { ".validate": "newData.isString()" },
          "spiel": { ".validate": "newData.isString() && newData.val() == root.child('partie').child($raum).child('info').child('spiel').val()" },
          "seit": { ".validate": "newData.isNumber()" },
          "$anderes": { ".validate": false }
        }
      }
    },
    "liveOffen": {
      ".read": true,
      "$code": {
        ".write": "$code.matches(/^[A-Z2-9]{4,12}$/) && auth != null && auth.token.email_verified == true && (auth.token.email == 'alain.sc2@gmail.com' || auth.token.email == 'Alain.sc2@gmail.com')",
        ".validate": "newData.hasChildren(['name']) && root.child('live').child($code).child('info').exists()",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "seit": { ".validate": "newData.isNumber()" },
        "$anderes": { ".validate": false }
      }
    },
    "turnierLive": {
      "$turnier": {
        ".read": "$turnier.matches(/^[a-z0-9-]+$/)",
        ".write": "$turnier.matches(/^[a-z0-9-]+$/) && auth != null && auth.token.email_verified == true && (auth.token.email == 'alain.sc2@gmail.com' || auth.token.email == 'Alain.sc2@gmail.com')",
        ".validate": "newData.hasChildren(['code', 'name'])",
        "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z2-9]{4,12}$/)" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "seit": { ".validate": "newData.isNumber()" },
        "$anderes": { ".validate": false }
      }
    },
    "turnierMitschauen": {
      "$turnier": {
        ".read": "$turnier.matches(/^[a-z0-9-]{6,48}$/)",
        "$kennung": {
          ".write": "$turnier.matches(/^[a-z0-9-]{6,48}$/) && $kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
          ".validate": "newData.hasChildren(['name', 'runde', 'lebt'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "lebt": { ".validate": "newData.isNumber()" },
          "runde": {
            ".validate": "newData.hasChildren(['id', 'spiel', 'start'])",
            "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{4,24}$/)" },
            "spiel": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,30}$/)" },
            "saat": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "start": { ".validate": "newData.isNumber()" },
            "$anderes": { ".validate": false }
          },
          "teile": {
            "$n": { ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.isString() && newData.val().length <= 8000" }
          },
          "ende": {
            ".validate": "newData.hasChildren(['p'])",
            "p": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "o": { ".validate": "newData.isNumber()" },
            "z": { ".validate": "newData.isNumber()" },
            "$anderes": { ".validate": false }
          },
          "$anderes": { ".validate": false }
        }
      }
    },
    "mitschauen": {
      "$kennung": {
        ".read": "$kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
        ".write": "$kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
        ".validate": "newData.hasChildren(['name', 'runde', 'lebt'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
        "lebt": { ".validate": "newData.isNumber()" },
        "runde": {
          ".validate": "newData.hasChildren(['id', 'spiel', 'start'])",
          "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{4,24}$/)" },
          "spiel": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,30}$/)" },
          "saat": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "start": { ".validate": "newData.isNumber()" },
          "$anderes": { ".validate": false }
        },
        "teile": {
          "$n": { ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.isString() && newData.val().length <= 8000" }
        },
        "ende": {
          ".validate": "newData.hasChildren(['p'])",
          "p": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "o": { ".validate": "newData.isNumber()" },
          "z": { ".validate": "newData.isNumber()" },
          "$anderes": { ".validate": false }
        },
        "$anderes": { ".validate": false }
      }
    },
    "amSpielen": {
      ".read": true,
      "$kennung": {
        ".write": "$kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
        ".validate": "newData.hasChildren(['name', 'spiel', 'lebt'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
        "spiel": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,30}$/)" },
        "lebt": { ".validate": "newData.isNumber()" },
        "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
        "fertig": { ".validate": "newData.isBoolean()" },
        "$anderes": { ".validate": false }
      }
    },
    "turnierAmSpielen": {
      "$turnier": {
        ".read": "$turnier.matches(/^[a-z0-9-]{6,48}$/)",
        "$kennung": {
          ".write": "$turnier.matches(/^[a-z0-9-]{6,48}$/) && $kennung.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
          ".validate": "newData.hasChildren(['name', 'spiel', 'lebt'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "spiel": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,30}$/)" },
          "lebt": { ".validate": "newData.isNumber()" },
          "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "fertig": { ".validate": "newData.isBoolean()" },
          "$anderes": { ".validate": false }
        }
      }
    },
    "zuschauer": {
      "$spieler": {
        ".read": "$spieler.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
        "$ich": {
          ".write": "$spieler.matches(/^mini_[A-Za-z0-9_-]{8,48}$/) && $ich.matches(/^mini_[A-Za-z0-9_-]{8,48}$/)",
          ".validate": "newData.hasChildren(['name', 'lebt'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "lebt": { ".validate": "newData.isNumber()" },
          "$anderes": { ".validate": false }
        }
      }
    }
  }
}
